"0	LINE	0
	pipeline {
	    agent any
	
	    environment {
	        DEV_REPO="babubalasubramaniyan/dev"
	        PROD_REPO="babubalasubramaniyan/prod"
	        IMAGE_NAME="react-app-1"
	    }
	
	    stages {
	
	        stage('Clone Code') {
	            steps {
	                git url: 'https://github.com/BabuBalasubramaniyan/Babu-B/tree/dev',
	                branch: "${env.dev}"
	            }
	        }
	
	        stage('Build Docker Image') {
	            steps {
	                sh 'docker build -t $react-app-1 .'
	            }
	        }
	
	        stage('Login DockerHub') {
	            steps {
	                withCredentials([usernamePassword(
	                credentialsId: 'dockerhub-creds',
	                usernameVariable: 'babubalasubramaniyan',
	                passwordVariable: 'Babu@#0805'
	                )]) {
	
	                sh 'echo $PASS | docker login -u $USER --password-stdin'
	                }
	            }
	        }
	
	        stage('Push to DEV Repo') {
	            when {
	                branch 'dev'
	            }
	            steps {
	                sh '''
	                docker tag $react-app-1 $DEV_REPO:latest
	                docker push $DEV_REPO:latest
	                '''
	            }
	        }
	
	        stage('Push to PROD Repo') {
